---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { layerForTag } from '../../lib/layers.js';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const monthDay = (d: Date) => d.toISOString().slice(5, 10).replace('-', '·');
---
<Base title="Archive" description="Every Disformal essay and note, by year.">
  <main id="main" class="wrap page-head">
    <div class="section-head">
      <div class="section-head__main">
        <p class="label reveal"><a href="/blog/">Essays</a> / Archive</p>
        <h1 class="h-page reveal" style="--d:1">The <em>archive.</em></h1>
      </div>
    </div>
    {years.map((year) => (
      <section class="archive-year reveal" aria-labelledby={`y${year}`}>
        <h2 id={`y${year}`} class="year-group__label">0{year}</h2>
        <ul class="archive-list">
          {posts.filter((p) => p.data.date.getUTCFullYear() === year).map((post) => (
            <li>
              <a class="archive-row" href={`/blog/${post.id}/`} style={`--c:var(--${layerForTag(post.data.tags[0] ?? '')})`}>
                <span class="archive-row__title">{post.data.title}</span>
                <span class="label">{monthDay(post.data.date)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</Base>
