---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FeaturedEssay from '../../components/FeaturedEssay.astro';
import PostRow from '../../components/PostRow.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const lead = posts.find((p) => p.data.featured);
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))].sort((a, b) => b - a);
---
<Base title="Essays" description="Essays and notes from Disformal on academia, space, science and AI.">
  <main id="main">
    <section class="wrap page-head" aria-labelledby="essays-title">
      <div class="section-head">
        <div class="section-head__main">
          <p class="label reveal">From the garden</p>
          <h1 id="essays-title" class="h-page reveal" style="--d:1">Essays, <em>with the working shown.</em></h1>
        </div>
        <div class="section-head__aside reveal" style="--d:2">
          <p>Long-form essays and shorter notes on academia, space, science and AI. Every essay opens a thread in the <a href="/common-room/">Common Room</a>.</p>
          <nav class="site-nav page-head__nav" aria-label="Essay indexes">
            <a href="/blog/archive/">Archive</a>
            <a href="/blog/tags/">Tags</a>
            <a href="/blog/graph/">Link graph</a>
            <a href="/blog/rss.xml">RSS</a>
          </nav>
        </div>
      </div>
      {lead && <FeaturedEssay post={lead} level={2} />}
    </section>

    <section class="section" aria-labelledby="all-title">
      <div class="wrap section__in">
        <div class="list-head">
          <h2 id="all-title" class="label">Everything, newest first</h2>
          {years.length > 1 && (
            <nav class="site-nav" aria-label="Jump to year">
              {years.map((y) => <a href={`#y${y}`}>0{y}</a>)}
            </nav>
          )}
        </div>
        {years.map((year) => (
          <div class="year-group" id={`y${year}`}>
            <p class="year-group__label">0{year}</p>
            {posts.filter((p) => p.data.date.getUTCFullYear() === year).map((post) => <PostRow post={post} />)}
          </div>
        ))}
      </div>
    </section>
  </main>
</Base>
