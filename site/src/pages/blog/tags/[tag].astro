---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostRow from '../../../components/PostRow.astro';
import { layerForTag } from '../../../lib/layers.js';
import { tagLabel } from '../../../lib/format.js';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((p) => p.data.tags.includes(tag)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={`#${tagLabel(tag)}`} description={`Disformal essays tagged ${tagLabel(tag)}.`}>
  <main id="main" class="wrap page-head">
    <div class="section-head">
      <div class="section-head__main">
        <p class="label reveal"><a href="/blog/">Essays</a> / <a href="/blog/tags/">Tags</a></p>
        <h1 class="h-page reveal" style={`--d:1;color:var(--${layerForTag(tag)})`}>#{tagLabel(tag)}</h1>
      </div>
      <p class="section-head__aside reveal" style="--d:2">{posts.length} {posts.length === 1 ? 'piece' : 'pieces'} tagged {tagLabel(tag)}.</p>
    </div>
    <div class="tag-posts">
      {posts.map((post) => <PostRow post={post} />)}
    </div>
  </main>
</Base>
