---
import fs from 'node:fs';
import path from 'node:path';
import { layerForTag } from '../lib/layers.js';
import { seeded } from '../lib/random.js';

interface Props {
  seed: string;
  tags: string[];
  image?: string;
}
const { seed, tags, image } = Astro.props;

// Use the post's cover image only if the file is really there; otherwise draw its spectral bars.
const hasImage = image && (!image.startsWith('/') || fs.existsSync(path.join(process.cwd(), 'public', image)));
const bands = [...new Set(tags.map(layerForTag))];
if (bands.length === 0) bands.push('accent');

const rand = seeded(seed);
const N = 120;
let v = 0.25;
const heights = Array.from({ length: N }, () => (v = Math.min(1, Math.max(0.04, v + (rand() - 0.46) * 0.08))));
const runs = bands.map((band, k) => ({
  band,
  d: heights
    .map((h, i) => ({ h, i }))
    .filter(({ i }) => Math.floor((i / N) * bands.length) === k)
    .map(({ h, i }) => `M${60 + i * 9},440V${(432 - 372 * h).toFixed(1)}`)
    .join(''),
}));
---
{hasImage ? (
  <img src={image} alt="" loading="lazy" />
) : (
  <svg viewBox="0 0 1200 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path d="M60,340H1140M60,240H1140M60,140H1140" stroke="var(--line)" stroke-dasharray="3 6" />
    {runs.map((r, k) => <path class="bars" d={r.d} stroke={`var(--${r.band})`} stroke-width="3" style={`--k:${k}`} />)}
    <path d="M60,440H1140" stroke="var(--text)" opacity=".5" />
  </svg>
)}
