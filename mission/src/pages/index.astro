---
import Base from '../layouts/Base.astro';
---
<Base title="Mission" current="mission">
  <main id="main" class="construction">
    <svg class="construction-art" viewBox="0 0 200 170" aria-hidden="true">
      <path class="anvil" d="M52,96 H160 V114 L142,122 V138 L164,150 H48 L70,138 V122 L52,114 C40,112 28,110 14,106 C22,100 36,96 52,96 Z" />
      <path class="anvil-line" d="M62,105 H150" />
      <g class="sparks">
        <path d="M80,90 L66,78" />
        <path d="M78,92 L62,88" />
        <path d="M86,84 L82,68" />
        <path d="M124,93 L138,91" />
        <path d="M114,64 L120,52" />
      </g>
      <g class="hammer">
        <rect class="hammer-handle" x="118" y="79" width="66" height="8" rx="4" />
        <rect class="hammer-head" x="86" y="70" width="34" height="26" rx="4" />
        <path class="hammer-band" d="M98,70 V96" />
      </g>
    </svg>
    <h1 class="construction-text">Under construction</h1>
  </main>
</Base>
