---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = await getCollection('posts');
const tagCounts = posts.flatMap(p => p.data.tags ?? []).reduce((acc, tag) => {
  acc[tag] = (acc[tag] ?? 0) + 1;
  return acc;
}, {} as Record<string, number>);
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---
<Base title="Tags" current="blog">
  <main id="main" class="wrap">
    <h1 class="page-title">Tags</h1>
    <ul class="tag-cloud">
      {tags.map(([tag, count]) => (
        <li><a href={`/tags/${tag}/`} class="tag-pill">{tag} <span class="tag-count-badge">{count}</span></a></li>
      ))}
    </ul>
  </main>
</Base>
