---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const byYear = posts.reduce((acc, post) => {
  const year = post.data.date.getUTCFullYear();
  (acc[year] ??= []).push(post);
  return acc;
}, {} as Record<number, typeof posts>);
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
---
<Base title="Archive" current="blog">
  <main id="main" class="wrap">
    <h1 class="page-title">Archive</h1>
    {years.map(year => (
      <section class="archive-year">
        <h2 class="archive-year-heading">{year}</h2>
        <ul class="archive-list">
          {byYear[year].map(post => (
            <li class="archive-item">
              <a href={`/${post.id}/`} class="archive-link">
                <span class="archive-title">{post.data.title}</span>
                <span class="archive-date">{post.data.comingSoon ? 'Coming soon' : post.data.date.toISOString().slice(5, 10)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</Base>
